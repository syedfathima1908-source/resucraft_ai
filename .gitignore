# ==========================================
# ResuCraft AI - Root GitIgnore Configuration
# ==========================================

# ------------------------------------------
# Environment Variables & Secrets (CRITICAL)
# ------------------------------------------
.env
*.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!.env*.example

# API Keys, Certificates, Tokens & Secrets
*.pem
*.key
*.pfx
*.p12
*.crt
*.csr
credentials.json
client_secret*.json
secrets.json
*.secret

# ------------------------------------------
# Python & Virtual Environments
# ------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
backend/venv/
backend/env/
backend/.venv/

# Python Bytecode & Cache
__pycache__/
backend/__pycache__/
*.py[cod]
*$py.class

# Python Testing & Coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Python Packaging & Distribution
build/
dist/
sdist/
wheels/
*.egg-info/
.eggs/

# ------------------------------------------
# Node.js & Frontend Build Outputs
# ------------------------------------------
node_modules/
frontend/node_modules/

# Frontend Build & Dist Directories
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
.next/
.nuxt/
.output/
.vite/
.cache/

# Logs & Debug Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ------------------------------------------
# Storage, Uploads & Local Scratch Artifacts
# ------------------------------------------
# Local Uploaded Resumes and Storage Files
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep
storage/uploads/*
!storage/uploads/.gitkeep

# Scratch Directory & Local Test Data
scratch/
*.tmp
*.temp

# ------------------------------------------
# IDEs, Editors & OS System Files
# ------------------------------------------
# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# IntelliJ / PyCharm / WebStorm
.idea/

# Windows & Visual Studio
.vs/
*.suo
*.user
*.userosv
*.sln.docstates
*.ntvs*
*.njsproj
*.sln
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSSharedFileList
.Spotlight-V100
.Trashes

# Editor Backup & Temp Files
*.swp
*.swo
*~
*.bak

# ------------------------------------------
# AI & Agent Workspace Caches
# ------------------------------------------
.antigravity/
.antigravityignore
.gemini/
.claude/
.ai/
